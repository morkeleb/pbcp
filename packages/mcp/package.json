{
  "name": "@pbcp/mcp",
  "version": "0.8.0",
  "description": "PBCP MCP server over stdio: submit_card and poll_changes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pbcp-mcp": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pbcp/client": "workspace:*",
    "@pbcp/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morkeleb/pbcp.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/morkeleb/pbcp/tree/main/packages/mcp",
  "keywords": [
    "pbcp",
    "protocol",
    "cards"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  }
}
