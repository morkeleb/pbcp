{
  "name": "@pbcp/core",
  "version": "0.8.0",
  "description": "PBCP protocol core: card schema, id grammar, restricted YAML, lifecycle transitions. No I/O.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./conformance": {
      "source": "./conformance/index.ts",
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./conformance/vitest": {
      "source": "./conformance/vitest.ts",
      "types": "./dist/conformance/vitest.d.ts",
      "default": "./dist/conformance/vitest.js"
    },
    "./conformance/render": {
      "source": "./conformance/render.ts",
      "types": "./dist/conformance/render.d.ts",
      "default": "./dist/conformance/render.js"
    }
  },
  "files": [
    "dist",
    "conformance/fixtures",
    "conformance/README.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "vitest": "*"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morkeleb/pbcp.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/morkeleb/pbcp/tree/main/packages/core",
  "keywords": [
    "pbcp",
    "protocol",
    "cards"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./conformance": {
        "types": "./dist/conformance/index.d.ts",
        "default": "./dist/conformance/index.js"
      },
      "./conformance/vitest": {
        "types": "./dist/conformance/vitest.d.ts",
        "default": "./dist/conformance/vitest.js"
      },
      "./conformance/render": {
        "types": "./dist/conformance/render.d.ts",
        "default": "./dist/conformance/render.js"
      }
    }
  }
}
