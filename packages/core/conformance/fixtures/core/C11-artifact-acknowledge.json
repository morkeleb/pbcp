{
  "name": "C11 acknowledging an artifact sets acknowledged_at and the card stays open; artifacts carry no actions and decision cards are never acknowledged",
  "rfc": [
    "§4.2",
    "§6",
    "§4.1"
  ],
  "covers": [
    "§4.1 cards never carry it",
    "§4.2 MUST NOT set it on a decision card",
    "§7.2 MUST increase whenever its current representation changes"
  ],
  "steps": [
    {
      "op": "put",
      "args": {
        "token": "hermes",
        "card": {
          "protocol": "pbcp/1",
          "id": "hermes:gmail:19b07c2d4e11",
          "kind": "artifact",
          "to_person": "morten",
          "producer": "hermes",
          "title": "Newsletter from Nordic Supply",
          "body": "Quarterly update; no action needed.",
          "emitted_at": "2026-10-07T13:02:11Z",
          "urgency": "log",
          "thread": "gmail:19b07c2d4e11"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "state": "open",
          "acknowledged_at": {
            "$absent": true
          }
        }
      }
    },
    {
      "op": "seen",
      "args": {
        "id": "hermes:gmail:19b07c2d4e11"
      },
      "expect": {
        "status": 200,
        "body": {
          "seen_at": {
            "$present": true
          },
          "acknowledged_at": {
            "$absent": true
          }
        }
      }
    },
    {
      "op": "syncAll",
      "args": {
        "token": "hermes",
        "after": 0
      },
      "expect": {
        "status": 200,
        "body": {
          "changes": [
            {
              "card": {
                "id": "hermes:gmail:19b07c2d4e11",
                "acknowledged_at": {
                  "$absent": true
                }
              }
            }
          ]
        }
      },
      "save": {
        "seqSeen": "body.changes.0.seq"
      }
    },
    {
      "op": "acknowledge",
      "args": {
        "id": "hermes:gmail:19b07c2d4e11"
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "hermes:gmail:19b07c2d4e11",
          "state": "open",
          "acknowledged_at": {
            "$present": true
          },
          "decision": {
            "$absent": true
          }
        }
      }
    },
    {
      "op": "syncAll",
      "args": {
        "token": "hermes",
        "after": {
          "$var": "seqSeen"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "changes": [
            {
              "seq": {
                "$gt": {
                  "$var": "seqSeen"
                }
              },
              "card": {
                "id": "hermes:gmail:19b07c2d4e11",
                "state": "open",
                "acknowledged_at": {
                  "$present": true
                },
                "decision": {
                  "$absent": true
                },
                "decided_at": {
                  "$absent": true
                }
              }
            }
          ]
        }
      }
    },
    {
      "op": "put",
      "args": {
        "token": "hermes",
        "card": {
          "protocol": "pbcp/1",
          "id": "hermes:gmail:19b07c2d4e11",
          "kind": "artifact",
          "to_person": "morten",
          "producer": "hermes",
          "title": "Newsletter from Nordic Supply",
          "body": "Quarterly update; prices unchanged.",
          "emitted_at": "2026-10-07T13:02:11Z",
          "urgency": "log",
          "thread": "gmail:19b07c2d4e11"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "state": "open"
        }
      }
    },
    {
      "op": "put",
      "args": {
        "token": "hermes",
        "card": {
          "protocol": "pbcp/1",
          "kind": "artifact",
          "to_person": "morten",
          "title": "Test card",
          "body": "Evidence.\n\n## Proposal\n\nDo it.",
          "emitted_at": "2026-10-07T09:00:00Z",
          "id": "hermes:gmail:artifact-actions",
          "producer": "hermes",
          "actions": [
            "archive",
            "keep"
          ]
        }
      },
      "expect": {
        "status": 400
      }
    },
    {
      "op": "put",
      "args": {
        "token": "hermes",
        "card": {
          "protocol": "pbcp/1",
          "kind": "decision",
          "to_person": "morten",
          "title": "Test card",
          "body": "Evidence.\n\n## Proposal\n\nDo it.",
          "emitted_at": "2026-10-07T09:00:00Z",
          "id": "hermes:gmail:decision-ack",
          "producer": "hermes"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "op": "acknowledge",
      "args": {
        "id": "hermes:gmail:decision-ack"
      }
    },
    {
      "op": "syncAll",
      "args": {
        "token": "hermes",
        "after": 0
      },
      "expect": {
        "status": 200,
        "body": {
          "changes": {
            "$contains": [
              {
                "card": {
                  "id": "hermes:gmail:decision-ack",
                  "state": "open",
                  "acknowledged_at": {
                    "$absent": true
                  }
                }
              }
            ],
            "$none": {
              "card": {
                "id": "hermes:gmail:artifact-actions"
              }
            }
          }
        }
      }
    }
  ]
}
