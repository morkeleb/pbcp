          "kind": "artifact",
          "to_person": "morten",
          "producer": "hermes",
          "title": "Invoice timing for September",
          "body": "Anna asks to pay the September invoice on the 20th.",
          "emitted_at": "2026-10-07T13:02:11Z",
          "labels": [
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "q4-2026"
          ]
        }
      },
