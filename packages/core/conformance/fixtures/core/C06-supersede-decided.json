{
  "name": "C06 superseding a decided card keeps the predecessor decision intact",
  "rfc": [
    "§8",
    "§6",
    "§5"
  ],
  "steps": [
    {
      "op": "put",
      "args": {
        "token": "goalpath",
        "card": {
          "protocol": "pbcp/1",
          "id": "goalpath:item:4421",
          "kind": "decision",
          "to_person": "morten",
          "producer": "goalpath",
          "title": "Approve shipping item 4421 Friday",
          "body": "Tests are green.\n\n## Proposal\n\nShip on Friday.",
          "emitted_at": "2026-10-07T06:05:00Z",
          "thread": "item:4421"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "op": "decide",
      "args": {
        "id": "goalpath:item:4421",
        "decision": {
          "decision": "approve",
          "comment": "Go"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "state": "decided",
          "decision": "approve"
        }
      }
    },
    {
      "op": "put",
      "args": {
        "token": "goalpath",
        "card": {
          "protocol": "pbcp/1",
          "id": "goalpath:item:4421:revised",
          "kind": "decision",
          "to_person": "morten",
          "producer": "goalpath",
          "title": "Approve shipping item 4421 Monday",
          "body": "One test regressed overnight.\n\n## Proposal\n\nShip on Monday instead.",
          "emitted_at": "2026-10-07T07:00:00Z",
          "thread": "item:4421",
          "supersedes": "goalpath:item:4421"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "id": "goalpath:item:4421:revised",
          "state": "open",
          "supersedes": "goalpath:item:4421"
        }
      }
    },
    {
      "op": "syncAll",
      "args": {
        "token": "goalpath",
        "after": 0
      },
      "expect": {
        "status": 200,
        "body": {
          "changes": {
            "$len": 2,
            "$contains": [
              {
                "card": {
                  "id": "goalpath:item:4421",
                  "state": "superseded",
                  "decision": "approve",
                  "comment": "Go",
                  "decided_at": {
                    "$present": true
                  }
                }
              },
              {
                "card": {
                  "id": "goalpath:item:4421:revised",
                  "state": "open",
                  "decision": {
                    "$absent": true
                  }
                }
              }
            ]
          }
        }
      },
      "save": {
        "seqOld": "body.changes.[card.id=goalpath:item:4421].seq"
      }
    },
    {
      "op": "put",
      "args": {
        "token": "goalpath",
        "card": {
          "protocol": "pbcp/1",
          "id": "goalpath:item:4421",
          "kind": "decision",
          "to_person": "morten",
          "producer": "goalpath",
          "title": "Approve shipping item 4421 Friday",
          "body": "Tests are green.\n\n## Proposal\n\nShip on Friday.",
          "emitted_at": "2026-10-08T06:05:00Z",
          "thread": "item:4421"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "goalpath:item:4421",
          "state": "superseded",
          "decision": "approve",
          "change_seq": {
            "$var": "seqOld"
          }
        }
      }
    },
    {
      "op": "put",
      "args": {
        "token": "goalpath",
        "card": {
          "protocol": "pbcp/1",
          "id": "goalpath:item:4421",
          "kind": "decision",
          "to_person": "morten",
          "producer": "goalpath",
          "title": "Approve shipping item 4421 Saturday",
          "body": "Tests are green.\n\n## Proposal\n\nShip on Friday.",
          "emitted_at": "2026-10-07T06:05:00Z",
          "thread": "item:4421"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "id": "goalpath:item:4421",
          "state": "superseded",
          "decision": "approve",
          "title": "Approve shipping item 4421 Friday"
        }
      }
    }
  ]
}
