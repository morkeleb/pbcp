{
  "name": "C53 a task that lists done in its actions is 400 invalid_card, and nothing is stored",
  "rfc": [
    "§4.1",
    "§7.4"
  ],
  "covers": [
    "§4.1 a task whose `actions` contain `done` or `edit`",
    "§7.4 a code under a status other than its own"
  ],
  "steps": [
    {
      "op": "put",
      "args": {
        "token": "todo",
        "card": {
          "protocol": "pbcp/1",
          "id": "todo:task:7732",
          "kind": "task",
          "to_person": "morten",
          "producer": "todo",
          "title": "Renew the passport",
          "body": "Form and photo at the town hall.",
          "emitted_at": "2026-11-05T06:00:00Z",
          "actions": [
            "tomorrow",
            "done"
          ]
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": "invalid_card"
        }
      }
    },
    {
      "op": "syncAll",
      "args": {
        "token": "todo",
        "after": 0
      },
      "expect": {
        "status": 200,
        "body": {
          "changes": {
            "$len": 0
          }
        }
      }
    }
  ]
}
