{
  "name": "C30 a producer token on the owner's decide is 401 unauthorized and the card stays open",
  "rfc": [
    "\u00a77.3",
    "\u00a77.4"
  ],
  "steps": [
    {
      "op": "put",
      "args": {
        "token": "hermes",
        "card": {
          "protocol": "pbcp/1",
          "id": "hermes:gmail:d1",
          "kind": "decision",
          "to_person": "morten",
          "producer": "hermes",
          "title": "Reply to Anna",
          "body": "Evidence.\n\n## Proposal\n\nReply.",
          "emitted_at": "2026-10-07T06:00:00Z"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "op": "decideWithToken",
      "args": {
        "token": "hermes",
        "id": "hermes:gmail:d1",
        "decision": {
          "decision": "approve"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    },
    {
      "op": "syncAll",
      "args": {
        "token": "hermes",
        "after": 0
      },
      "expect": {
        "status": 200,
        "body": {
          "changes": [
            {
              "card": {
                "id": "hermes:gmail:d1",
                "state": "open",
                "decision": {
                  "$absent": true
                }
              }
            }
          ]
        }
      }
    },
    {
      "op": "decide",
      "args": {
        "id": "hermes:gmail:d1",
        "decision": {
          "decision": "approve"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "state": "decided",
          "decision": "approve"
        }
      }
    }
  ]
}
