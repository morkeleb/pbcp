{
  "name": "C33 claim_seq counts claims, not renewals: claim 1, renew keeps 1, re-claim after expiry 2, renew keeps 2",
  "rfc": [
    "A.1",
    "A.2",
    "A.3"
  ],
  "extension": "orders",
  "steps": [
    {
      "op": "clock",
      "args": {
        "set": "2026-10-07T09:00:00Z"
      }
    },
    {
      "op": "syncAll",
      "args": {
        "token": "hermes",
        "executor": true,
        "after": 0
      },
      "expect": {
        "status": 200,
        "body": {
          "changes": {
            "$len": 0
          }
        }
      }
    },
    {
      "op": "syncAll",
      "args": {
        "token": "cal",
        "executor": true,
        "after": 0
      },
      "expect": {
        "status": 200,
        "body": {
          "changes": {
            "$len": 0
          }
        }
      }
    },
    {
      "op": "order",
      "args": {
        "to_producer": "*",
        "title": "Book the dentist",
        "body": "Any weekday morning."
      },
      "expect": {
        "status": 201
      },
      "save": {
        "o": "body.id"
      }
    },
    {
      "op": "claim",
      "args": {
        "token": "hermes",
        "executor": true,
        "id": {
          "$var": "o"
        },
        "lease": 60
      },
      "expect": {
        "status": 200,
        "body": {
          "claim_seq": 1,
          "claimed_by": "hermes",
          "claim_expires_at": "2026-10-07T09:01:00Z"
        }
      }
    },
    {
      "op": "clock",
      "args": {
        "set": "2026-10-07T09:00:30Z"
      }
    },
    {
      "op": "claim",
      "args": {
        "token": "hermes",
        "executor": true,
        "id": {
          "$var": "o"
        },
        "lease": 60
      },
      "expect": {
        "status": 200,
        "body": {
          "claim_seq": 1,
          "claimed_by": "hermes",
          "claim_expires_at": "2026-10-07T09:01:30Z"
        }
      }
    },
    {
      "op": "clock",
      "args": {
        "set": "2026-10-07T09:01:15Z"
      }
    },
    {
      "op": "claim",
      "args": {
        "token": "cal",
        "executor": true,
        "id": {
          "$var": "o"
        },
        "lease": 60
      },
      "expect": {
        "status": 409
      }
    },
    {
      "op": "clock",
      "args": {
        "set": "2026-10-07T09:01:30Z"
      }
    },
    {
      "op": "claim",
      "args": {
        "token": "cal",
        "executor": true,
        "id": {
          "$var": "o"
        },
        "lease": 60
      },
      "expect": {
        "status": 200,
        "body": {
          "claim_seq": 2,
          "claimed_by": "cal"
        }
      }
    },
    {
      "op": "claim",
      "args": {
        "token": "hermes",
        "executor": true,
        "id": {
          "$var": "o"
        },
        "lease": 60
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "lease_held",
          "order": {
            "claim_seq": 2
          }
        }
      }
    },
    {
      "op": "claim",
      "args": {
        "token": "cal",
        "executor": true,
        "id": {
          "$var": "o"
        },
        "lease": 60
      },
      "expect": {
        "status": 200,
        "body": {
          "claim_seq": 2,
          "claimed_by": "cal"
        }
      }
    }
  ]
}
