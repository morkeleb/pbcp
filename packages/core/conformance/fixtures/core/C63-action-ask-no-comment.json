{
  "name": "C63 an option with ask is decided with or without a comment; the comment is recorded as sent",
  "rfc": [
    "§4.4",
    "§4.5",
    "§7.3"
  ],
  "covers": [
    "§7.3 `decision` MUST be one of the card's `actions` other than `edit`"
  ],
  "steps": [
    {
      "op": "put",
      "args": {
        "token": "mail",
        "card": {
          "protocol": "pbcp/1",
          "id": "mail:reply:4414",
          "kind": "decision",
          "to_person": "morten",
          "producer": "mail",
          "title": "Reply to Anna re invoice timing",
          "summary": "Anna asks to pay the September invoice on the 20th instead of the 15th. The proposed reply agrees for September only.",
          "body": "Anna (Nordic Supply) asks whether the September invoice can be paid on the 20th instead of the 15th.\n\n## Proposed reply\n\n> Hi Anna, the 20th is fine for September.",
          "emitted_at": "2026-11-20T07:00:00Z",
          "actions": [
            {
              "id": "send",
              "label": "Send",
              "default": true
            },
            {
              "id": "redraft",
              "label": "Redraft",
              "ask": "What should change?"
            },
            "edit"
          ]
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "op": "decide",
      "args": {
        "id": "mail:reply:4414",
        "decision": {
          "decision": "redraft"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "state": "decided",
          "decision": "redraft",
          "comment": {
            "$absent": true
          }
        }
      }
    },
    {
      "op": "put",
      "args": {
        "token": "mail",
        "card": {
          "protocol": "pbcp/1",
          "id": "mail:reply:4415",
          "kind": "decision",
          "to_person": "morten",
          "producer": "mail",
          "title": "Reply to Anna re invoice timing",
          "summary": "Anna asks to pay the September invoice on the 20th instead of the 15th. The proposed reply agrees for September only.",
          "body": "Anna (Nordic Supply) asks whether the September invoice can be paid on the 20th instead of the 15th.\n\n## Proposed reply\n\n> Hi Anna, the 20th is fine for September.",
          "emitted_at": "2026-11-20T07:00:00Z",
          "actions": [
            {
              "id": "send",
              "label": "Send",
              "default": true
            },
            {
              "id": "redraft",
              "label": "Redraft",
              "ask": "What should change?"
            },
            "edit"
          ]
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "op": "decide",
      "args": {
        "id": "mail:reply:4415",
        "decision": {
          "decision": "redraft",
          "comment": "Shorter, and offer the 18th instead."
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "state": "decided",
          "decision": "redraft",
          "comment": "Shorter, and offer the 18th instead."
        }
      }
    }
  ]
}
